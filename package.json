{
  "name": "family-os",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint",
    "test": "node --test tests/*.test.js",
    "test:vitest": "vitest run",
    "test:vitest:watch": "vitest",
    "test:all": "npm run test && npm run test:vitest",
    "test:visual": "node tests/visual-regression/compare-forms.mjs",
    "test:visual:update": "node tests/visual-regression/compare-forms.mjs --update-baseline",
    "preview": "vite preview",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "desktop:build:appstore": "bash scripts/build-appstore.sh",
    "mobile:android:init": "tauri android init",
    "mobile:android:build": "tauri android build",
    "mobile:android:bundle": "cd src-tauri/gen/android && ./gradlew bundleRelease",
    "mobile:ios:init": "tauri ios init",
    "mobile:ios:build": "tauri ios build",
    "mobile:ios:archive": "cd src-tauri/gen/apple && xcodebuild -workspace famos.xcworkspace -scheme famos -sdk iphoneos -configuration Release archive -archivePath build/famos.xcarchive",
    "appstore:check": "echo 'Checking app store metadata...' && cat app-store-metadata/README.md | head -20"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@supabase/supabase-js": "^2.110.2",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-deep-link": "^2.4.9",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "@zxing/browser": "^0.2.1",
    "@zxing/library": "^0.23.0",
    "date-fns": "^4.4.0",
    "framer-motion": "^12.42.2",
    "gsap": "^3.15.0",
    "idb-keyval": "^6.3.0",
    "lucide-react": "^1.23.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/vite": "^4.3.2",
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "autoprefixer": "^10.5.2",
    "jsdom": "^25.0.1",
    "oxlint": "^1.71.0",
    "pixelmatch": "^7.2.0",
    "playwright": "^1.61.1",
    "pngjs": "^7.0.0",
    "postcss": "^8.5.16",
    "tailwindcss": "^4.3.2",
    "vite": "^8.1.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^2.1.9",
    "web-push": "^3.6.7"
  }
}
