{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'none'; object-src 'none'; base-uri 'self'"
        }
      ]
    },
    {
      "source": "/helpers",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-store, max-age=0"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    },
    {
      "source": "/packs",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    },
    {
      "source": "/(.*).html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "fam-os.app"
        }
      ],
      "destination": "/__public/home.html"
    },
    {
      "source": "/pricing",
      "has": [
        {
          "type": "host",
          "value": "fam-os.app"
        }
      ],
      "destination": "/__public/pricing.html"
    },
    {
      "source": "/download",
      "has": [
        {
          "type": "host",
          "value": "fam-os.app"
        }
      ],
      "destination": "/__public/download.html"
    },
    {
      "source": "/contact",
      "has": [
        {
          "type": "host",
          "value": "fam-os.app"
        }
      ],
      "destination": "/__public/contact.html"
    },
    {
      "source": "/privacy",
      "has": [
        {
          "type": "host",
          "value": "fam-os.app"
        }
      ],
      "destination": "/__public/privacy.html"
    },
    {
      "source": "/terms",
      "has": [
        {
          "type": "host",
          "value": "fam-os.app"
        }
      ],
      "destination": "/__public/terms.html"
    },
    {
      "source": "/compare",
      "destination": "/__public/compare.html"
    },
    {
      "source": "/compare/skylight",
      "destination": "/__public/compare/skylight.html"
    },
    {
      "source": "/compare/cozi",
      "destination": "/__public/compare/cozi.html"
    },
    {
      "source": "/compare/familywall",
      "destination": "/__public/compare/familywall.html"
    },
    {
      "source": "/features",
      "destination": "/__public/features.html"
    },
    {
      "source": "/calendar-sync",
      "destination": "/__public/calendar-sync.html"
    },
    {
      "source": "/calendar-photo-import",
      "destination": "/__public/calendar-photo-import.html"
    },
    {
      "source": "/features/voice",
      "destination": "/__public/features/voice.html"
    },
    {
      "source": "/features/today",
      "destination": "/__public/features/today.html"
    },
    {
      "source": "/features/location",
      "destination": "/__public/features/location.html"
    },
    {
      "source": "/features/calendar",
      "destination": "/__public/features/calendar.html"
    },
    {
      "source": "/features/meals",
      "destination": "/__public/features/meals.html"
    },
    {
      "source": "/features/tasks",
      "destination": "/__public/features/tasks.html"
    },
    {
      "source": "/features/shopping",
      "destination": "/__public/features/shopping.html"
    },
    {
      "source": "/features/recipes",
      "destination": "/__public/features/recipes.html"
    },
    {
      "source": "/features/kitchen",
      "destination": "/__public/features/kitchen.html"
    },
    {
      "source": "/features/chat",
      "destination": "/__public/features/chat.html"
    },
    {
      "source": "/features/fam-ai",
      "destination": "/__public/features/fam-ai.html"
    },
    {
      "source": "/features/rewards",
      "destination": "/__public/features/rewards.html"
    },
    {
      "source": "/features/family",
      "destination": "/__public/features/family.html"
    },
    {
      "source": "/features/tablet",
      "destination": "/__public/features/tablet.html"
    },
    {
      "source": "/((?!assets/|icons/|marketing/|illustrations/|brand/|fonts/|manifest\\.webmanifest|registerSW\\.js|notification-sw\\.js|robots\\.txt|sitemap\\.xml|favicon\\.ico|sw\\.js|workbox-).*)",
      "destination": "/app-shell.html"
    }
  ],
  "redirects": [
    {
      "source": "/meal-planning",
      "destination": "/features/meals",
      "permanent": true
    },
    {
      "source": "/family-calendar",
      "destination": "/features/calendar",
      "permanent": true
    },
    {
      "source": "/family-dashboard",
      "destination": "/features/tablet",
      "permanent": true
    }
  ]
}
