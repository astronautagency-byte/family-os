[TEMPLATE]
# FamOS environment variables (template — copy to .env.local and fill real values).

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_GOOGLE_MAPS_API_KEY=your-google-maps-browser-key

# Server-side only: set these as Supabase Edge Function secrets, not Vite/browser env vars.
# They are listed here as a deployment checklist only. Do not put live values in this file.
WEATHERAPI_KEY=your-weatherapi-com-key
SERPAPI_KEY=your-serpapi-com-key
DOORDASH_DEVELOPER_ID=your-doordash-developer-id
DOORDASH_KEY_ID=your-doordash-key-id
DOORDASH_SIGNING_SECRET=your-doordash-signing-secret
TICKETMASTER_API_KEY=your-ticketmaster-api-key
SPOONACULAR_API_KEY=your-spoonacular-api-key

# Stripe billing — server-side secrets for Supabase Edge Functions.
# Use test keys while validating the checkout lifecycle, then switch to live keys.
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_test_your-webhook-signing-secret
STRIPE_PRICE_PLUS_MONTHLY=price_test_plus_monthly_xxx
STRIPE_PRICE_PLUS_YEARLY=price_test_plus_yearly_xxx
STRIPE_PRICE_PRO_MONTHLY=price_test_pro_monthly_xxx
STRIPE_PRICE_PRO_YEARLY=price_test_pro_yearly_xxx
FRONTEND_URL=https://home.fam-os.app

# Amazon SES / SNS for invites
AWS_REGION=ca-central-1
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
SES_FROM_EMAIL=hello@home.fam-os.app
SES_IDENTITY_REGION=ca-central-1
