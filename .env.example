# FamOS environment variables (template — copy to .env.local and fill real values).

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_GOOGLE_MAPS_API_KEY=your-google-maps-browser-key

# Server-side only: set these as Supabase Edge Function secrets, not Vite/browser env vars.
# They are listed here as a deployment checklist only. Do not put live values in this file.
WEATHERAPI_KEY=your-weatherapi-com-key
SERPAPI_KEY=your-serpapi-com-key
DOORDASH_DEVELOPER_ID=your-doordash-developer-id
DOORDASH_KEY_ID=your-doordash-key-id
DOORDASH_SIGNING_SECRET=your-doordash-signing-secret
TICKETMASTER_API_KEY=your-ticketmaster-api-key
RECIPE_API_KEY=your-recipe-api-key

# ── Stripe billing — server-side secrets for Edge Functions ──
# Test mode (sk_test_..., whsec_test_...) is fine for development; switch to
# live keys (sk_live_..., whsec_live_...) once the dashboard is wired up.
#
# Get the secret + webhook signing secret from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_test_your-webhook-signing-secret
#
# Stripe Price IDs for the four SKUs. Create in Dashboard → Products then paste
# the resulting price_… IDs here. Pricing must match src/data/pricingPlan.js.
STRIPE_PRICE_CORE_MONTHLY=price_test_core_monthly_xxx
STRIPE_PRICE_CORE_YEARLY=price_test_core_yearly_xxx
STRIPE_PRICE_BUNDLE_MONTHLY=price_test_bundle_monthly_xxx
STRIPE_PRICE_FAMAI_MONTHLY=price_test_famai_monthly_xxx
#
# Public URL of the deployed frontend — used to build Stripe success/cancel URLs.
FRONTEND_URL=https://fam-os.app

# Amazon SES / SNS for invites
AWS_REGION=ca-central-1
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
SES_FROM_EMAIL=hello@fam-os.app
# AWS SNS production SMS requires a support-case approval to leave the sandbox.
# Test mode SMS works to verified numbers immediately.
SES_IDENTITY_REGION=ca-central-1
