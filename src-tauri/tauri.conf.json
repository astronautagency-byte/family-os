{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FamOS",
  "version": "0.36.0",
  "identifier": "app.famos.desktop",
  "build": {
    "beforeDevCommand": "npm run dev -- --host 127.0.0.1",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "security": {
      "csp": null
    },
    "windows": [
      {
        "title": "FamOS",
        "width": 1440,
        "height": 960,
        "minWidth": 920,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis"],
    "icon": [
      "../public/icons/icon-192.png",
      "../public/icons/icon-512.png"
    ]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["famos"]
      }
    }
  }
}
