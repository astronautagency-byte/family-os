{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FamOS",
  "version": "1.0.0",
  "identifier": "app.fam-os.famos",
  "build": {
    "beforeDevCommand": "npm run dev -- --host 127.0.0.1",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "security": {
      "csp": null
    },
    "windows": [
      {
        "title": "FamOS - Family Organization",
        "width": 1440,
        "height": 960,
        "minWidth": 920,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "entitlements": "./FamOS-Release.entitlements",
      "minimumSystemVersion": "11.0",
      "providerShortName": "ZRDVT9WBN4"
    },
    "resources": ["PrivacyInfo.xcprivacy"],
    "copyright": "© 2026 FamOS, Inc. All rights reserved.",
    "category": "Productivity",
    "shortDescription": "Your family, finally in sync.",
    "longDescription": "FamOS brings calendars, meals, groceries, tasks, chat, and AI assistance into one private space your whole household can share."
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["famos"]
      }
    }
  }
}
